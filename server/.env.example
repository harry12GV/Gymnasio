# ---- Server ----
PORT=4000
NODE_ENV=development

# URL del frontend para CORS
CLIENT_URL=http://localhost:5173

# ---- JWT ----
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# ---- Supabase (PostgreSQL) ----
# Transaction pooler (puerto 6543) para la app con PgBouncer
DATABASE_URL="postgresql://postgres.[USER]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (puerto 5432) para migraciones de Prisma
DIRECT_URL="postgresql://postgres.[USER]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---- Seed ----
SUPER_ADMIN_EMAIL=admin@newstartgym.com
SUPER_ADMIN_PASSWORD=CambiaEsto123!
